set.seed(123)
ar1 <- arima.sim(n=100, list(ar=0.7))
# try different values of the coefficient
plot.ts(ar1)
(acf(ar1))
# ====simulating an AR(1) process====
set.seed(123)
ar1 <- arima.sim(n=100, list(ar=1))
