RW <- function(T, y0, mu, sig2) {
#  set.seed(100)
t<-1:T
eps <- cumsum(rnorm(n=T, mean=0, sd=sqrt(sig2))) # random steps are i.i.d. normal
y <- y0 + t*mu + eps  # mu is the drift parameter
return(y)
}
y1 <- RW(1000, 5, 0, 0.4)
plot(y1, type="l", xlab="t", main="Random Walk without Drift")
(acf(y1))
y2 <- RW(1000, 5, 0.1, 0.4)   # try a negative mu yourself
plot(y2, type="l", xlab="t", main="Random Walk with Drift")
(acf(y2))
# Another way to simulate random walks
y3 <- arima.sim(n=1000, model=list(order=c(0,1,0)), sd=sqrt(0.4))
plot(y3, type="l", xlab="t", main="Random Walk without Drift")
y4 <- 1:1001 * 0.1 + y3  # 0.1 is the drift parameter
plot(y4, type="l", xlab="t", main="Random Walk with Drift")
random_walk <- function(n.org, steps, left.p = .5, up.p = .5, plot = TRUE){
require(ggplot2)
whereto <- matrix(ncol = 2)
for(x in 1:n.org){
walker <- matrix(c(0,0), nrow = steps+1, ncol = 2, byrow = T)
for(i in 1:steps){
# left/right = 1/0
horizontal <- rbinom(1, 1, left.p)
# distance 2
h.dist <- abs(rnorm(1, 0, 1))
# Horizontal Movement
if(horizontal == 0){
walker[i+1,1] <- walker[i,1] + h.dist
}
if(horizontal == 1){
walker[i+1,1] <- walker[i,1] - h.dist
}
# up/down = 1/0
vertical <- rbinom(1, 1, up.p)
#distance 2
v.dist <- abs(rnorm(1, 0, 1))
# Vertical Movement
if(vertical == 1){
walker[i+1,2] <- walker[i,2] + v.dist
}
if(vertical == 0){
walker[i+1,2] <- walker[i,2] - v.dist
}
}
whereto <- rbind(whereto, walker)
}
id <- rep(1:n.org, each = 1001)
colnames(whereto) <- c("x" , "y")
whereto <- as.data.frame(whereto)
whereto <- cbind(whereto[2:nrow(whereto),], org = factor(id))
if(plot){
require(ggplot2)
p <- ggplot(whereto, aes(x = x, y = y, colour = org))
p <- p + geom_path()
print(p)
}
return(whereto)
}
rw.test <- random_walk(1, 1000, .5, .5)
# Code by Jon Borrelli
# Available at https://assemblingnetwork.wordpress.com/2014/03/24/random-walks-in-r/
library(ggplot2)
random_walk <- function(n.org, steps, left.p = .5, up.p = .5, plot = TRUE){
require(ggplot2)
whereto <- matrix(ncol = 2)
for(x in 1:n.org){
walker <- matrix(c(0,0), nrow = steps+1, ncol = 2, byrow = T)
for(i in 1:steps){
# left/right = 1/0
horizontal <- rbinom(1, 1, left.p)
# distance 2
h.dist <- abs(rnorm(1, 0, 1))
# Horizontal Movement
if(horizontal == 0){
walker[i+1,1] <- walker[i,1] + h.dist
}
if(horizontal == 1){
walker[i+1,1] <- walker[i,1] - h.dist
}
# up/down = 1/0
vertical <- rbinom(1, 1, up.p)
#distance 2
v.dist <- abs(rnorm(1, 0, 1))
# Vertical Movement
if(vertical == 1){
walker[i+1,2] <- walker[i,2] + v.dist
}
if(vertical == 0){
walker[i+1,2] <- walker[i,2] - v.dist
}
}
whereto <- rbind(whereto, walker)
}
id <- rep(1:n.org, each = 1001)
colnames(whereto) <- c("x" , "y")
whereto <- as.data.frame(whereto)
whereto <- cbind(whereto[2:nrow(whereto),], org = factor(id))
if(plot){
require(ggplot2)
p <- ggplot(whereto, aes(x = x, y = y, colour = org))
p <- p + geom_path()
print(p)
}
return(whereto)
}
rw.test <- random_walk(1, 1000, .5, .5)
# Simulate the DF distribution without a constant or trend
# ==========================================================
T <- 2000
reps <- 5000
DF_nc <- rep(NA, reps)
for (i in 1:reps){
u <- rnorm(T)
W <- 1/sqrt(T)*cumsum(u)
DF_nc[i] <- (W[T]^2-1)/(2*sqrt(mean(W^2)))
}
x <- seq(-4, 4, by=.1)
plot(density(DF_nc), lwd=2, col="red")
lines(x, dnorm(x), lwd=2, col="blue", lty="dashed")
legend(x= "topright",legend=c("DF distribution (no constant or trend)","Standard normal distribution"),
col=c("red", "blue"), lty=1:2)
# Compare the quantiles of standard normal and DF distributions
library(fUnitRoots)
qnorm(c(0.01,0.05,0.10))
qunitroot(c(0.01,0.05,0.10), trend="nc") # sample size defaults to Inf
qunitroot(c(0.01,0.05,0.10), trend="c")
qunitroot(c(0.01,0.05,0.10), trend="ct")
# Including a constant and trend shifts the DF distributions to the left
adfTable(trend="c") # tables critical values for the DF test
# trend = c("nc", "c", "ct")
# trend = c("nc", "c", "ct")
# trend = c("nc", "c", "ct")
library(quantmod)
getSymbols("TB3MS", src="FRED")
plot(TB3MS)
rt <- TB3MS["1999-04/2020-01"]
length(rt)
plot(rt)
acf(rt)
mean(rt)
#------------------------------------------------
library(tseries)  # requires tseries package
?adf.test
# Warning: adf.test() only runs the unrestricted regression,
# namely, it always includes a constant and a linear trend
adf.test(rt, k=0) # computes the DF test if setting the number of lags=0
adf.test(rt) # computes the ADF test
#------------------------------------------------
library(urca) # requires urca package
# ADF test
?ur.df # performs the ADF test
result <- ur.df(rt, type="none") # lags=1 by default
result <- ur.df(rt, type="none", lags=0) # computes the DF test if setting lags=0
result <- ur.df(rt, type="drift", lags=6, selectlags="AIC")
# selects the number of lags by AIC, where max number of lags is set by lags
result <- ur.df(rt, type="drift", lags=6)
result <- ur.df(rt, type="trend", lags=6)
summary(result) # For each of the above tests, use summary() to print the result
plot(result) # check residuals
# KPSS test
?kpss.test # requires tseries package
kpss.test(rt, "Level")
?ur.kpss # requires urca package
result <- ur.kpss(rt, type="mu", lags="short")
summary(result)
# Phillips-Perron test
?ur.pp
# ADF-GLS test (or Elliott, Rothenberg & Stock test)
?ur.ers
library(forecast)
?ndiffs
ndiffs(rt, test="kpss", type="level")
drt <- diff(rt)[-1]
plot(drt)
result <- ur.df(drt, type="drift", selectlags="AIC")
summary(result)
# Estimate GARCH models
# =====================
library(quantmod)
library(forecast)
library(rugarch)
MSFT_full <- getSymbols("MSFT", src="yahoo", auto.assign = F)
MSFT_full
plot(MSFT_full$MSFT.Close)
MSFT <- MSFT_full["2017/2019"]
head(MSFT)
tail(MSFT)
r <- diff(log(MSFT$MSFT.Close))[-1]
length(r)
plot(r, main="Daily returns")
plot(r^2, main="Daily squared returns")
tsdisplay(r)
Box.test(r, lag = 10, type="Ljung-Box")
tsdisplay(r^2)
Box.test(r^2, lag = 10, type="Ljung-Box")
library(FinTS)
ArchTest(r, 10)  # Engle's ARCH LM test
tsdiag(r)
?tsdiag
# Fit an ARCH(1) model
# ugarchspec defines the GARCH order by (q,p) (ARCH, GARCH)
spec_arch1 <- ugarchspec(variance.model = list(garchOrder=c(1,0)),
mean.model = list(armaOrder=c(0,0)))
fit_arch1 <- ugarchfit(spec=spec_arch1, data=r) # Fails to converge using default solver
fit_arch1 <- ugarchfit(spec=spec_arch1, data=r, solver ='hybrid')
fit_arch1
plot(fit_arch1)
# A VAR model of GDP growth rate and term spread
# ==============================================
library(quantmod)
library(urca)
library(vars)
# Retrieve quarterly real GDP
gdp <- getSymbols("GDPC1", src="FRED", auto.assign=FALSE)
plot(gdp)
gdpgr <- diff(log(gdp))*100  # real GDP growth rate
plot(gdpgr)
# Retrieve monthly short-term and long-term interest rates
getSymbols("TB3MS", src="FRED") # 3-Month Treasury Bill: Secondary Market Rate
getSymbols("GS10", src="FRED") # 10-Year Treasury Constant Maturity Rate
plot(merge(TB3MS, GS10), main = "Interest Rates")
addLegend("topright", legend.names = c("TB3MS", "GS10"),
lty=c(1,1), bg="white", bty="o")
spread <- GS10 - TB3MS  # term spread
spread_q <- apply.quarterly(spread, mean)
# compute quarterly spread by taking monthly averages
time(spread_q) <- as.Date(as.yearqtr(time(spread_q)))
data <- merge(gdpgr, spread_q)
colnames(data) <- c("GDP_growth", "Term_spread")
y <- data["1981/2019"] # select sample
plot(y)
ur_gdp <- ur.df(y$GDP_growth, type="drift", lags=4, selectlags="AIC")
summary(ur_gdp)
ur_spread <- ur.df(y$Term_spread, type="drift", lags=4, selectlags="AIC")
summary(ur_spread)
# Examine cross-correlation matrices
MTS::ccm(y) # requires MTS package (MTS also contains a function called VAR, but
# Compute the multivariate Ljung-Box Q statistics (adj=0 by default)
MTS::mq(y, lag=8)
# Order selection by information criteria
VARselect(y, type="const") # BIC is named "SC" (Schwarz criterion)
VAR_fit <- VAR(ts(y), p=2, type="const") # can choose lag order by "ic=" (but
# must set "lag.max" simultaneously)
summary(VAR_fit)
roots(VAR_fit, modulus=FALSE) # eigenvalues of the companion coefficient matrix
roots(VAR_fit) # modulus defaults to TRUE
# Diagnostic checking
res <- serial.test(VAR_fit, lags.pt=8, type="PT.adjusted")
res
plot(res)
# Forecasting
(fcast <- predict(VAR_fit, n.ahead=8))
plot(fcast)
fanchart(fcast)
# Granger causality
causality(VAR_fit, cause="GDP_growth")
causality(VAR_fit, cause="Term_spread")
# Impulse response function (by default, ortho = TRUE)
irf_gdp <- irf(VAR_fit, impulse="Term_spread", response="GDP_growth", n.ahead=20)
plot(irf_gdp, ylab="GDP growth")
irf_spread <- irf(VAR_fit, impulse="GDP_growth", response="Term_spread", n.ahead=20)
plot(irf_spread, ylab="Term spread")
plot(irf(VAR_fit)) # examine all four IRFs
fevd_result <- fevd(VAR_fit, n.ahead=12)
fevd_result
plot(fevd_result)
